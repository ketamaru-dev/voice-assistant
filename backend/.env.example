# Обязательные
GROQ_API_KEY=your_groq_api_key
APP_USER=your_login
APP_PASSWORD=long_random_password

# Необязательные (значения по умолчанию указаны справа)
# ALLOWED_ORIGINS=https://example.com        # CORS, по умолчанию выключен (страница и API на одном адресе)
# ENABLE_DOCS=false                          # /docs, /redoc, /openapi.json (при true открыты всем; токен вводится кнопкой Authorize)
# AUTH_SECRET=                               # секрет подписи токенов; пусто — производный от APP_USER/APP_PASSWORD (смена пароля отзывает токены)
# TOKEN_TTL_MINUTES=720                      # срок жизни токена входа (12 часов)
# LOGIN_ATTEMPTS_PER_MINUTE=10               # попыток входа в минуту с одного IP (защита от подбора пароля)
# MODEL_NAME=gpt-oss-20b
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=16384
# LOG_LEVEL=INFO
# MAX_TEXT_LENGTH=10000
# MAX_AUDIO_BYTES=10485760                   # предел размера файла озвучки (10 МБ)
# RATE_LIMIT_PER_MINUTE=30                   # 0 — без ограничения
# TTS_ATTEMPTS=3
# AUDIO_TTL_SECONDS=300
# CLEANUP_INTERVAL_SECONDS=120
# AUDIO_DIR=/tmp/voice_translator
# STATIC_DIR=../static
